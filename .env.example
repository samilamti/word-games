# Get a free access key at https://web3forms.com/
# Submissions are emailed to the address registered with the key.
# Leave unset for localStorage-only behavior (dev default).
VITE_WEB3FORMS_KEY=

# RevenueCat PUBLIC SDK keys (RevenueCat dashboard -> Project -> API keys).
# These are public/embeddable — safe to ship in the app — but keep the real
# values in .env.local (gitignored), not here. Leave unset to keep billing in
# local/dev mode (no real purchases). Full setup: docs/revenuecat-setup.md
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=
