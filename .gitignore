# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files with secrets (ASC API key, Web3Forms key, etc.)
# .env.local is already covered by *.local; these guard a future plain .env too
.env
.env.*
!.env.example

# iOS / Capacitor
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/App/Podfile.lock
ios/App/App/public/
ios/.sourcemaps/
ios/capacitor-cordova-ios-plugins/

# ASC API automation state (resource IDs, build numbers, etc.)
build/

# Raw dictionary downloads — normalized output goes into public/dictionaries/
tmp/

# Generated word-definition datasets (~300–450 MB) — DURABLE LOCAL storage:
# bundled into app builds (public/ → dist/ → cap sync) but never committed.
# Regenerate manually with `npm run data:all`.
public/definitions/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local art/audio generation: venv, raw model output, and review sheets. All
# regenerable and large; only the finished assets under public/ are committed.
scripts/art/.venv-art/
resources/art/raw/
resources/art/contact/
resources/audio/raw/

# Python bytecode from the Blender scripts
__pycache__/
*.pyc
